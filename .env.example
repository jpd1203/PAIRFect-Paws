APP_NAME="PAIRfect Paws"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
PRIVACY_CONTACT_EMAIL=
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_TIMEZONE=+00:00
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=180
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=null
MAIL_REQUIRE_TLS=true
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="your-address@gmail.com"
MAIL_FROM_NAME="PAIRfect Paws"
STAFF_ALERT_EMAIL="your-staff-inbox@gmail.com"
AUTH_VERIFICATION_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60

# Optional PayMongo integration. Keep empty for local mocked donations only.
PAYMONGO_SECRET_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Reservation queue: flag 72 hours after an interview, then allow 24 hours for admin review.
RESERVATION_TIMEZONE=Asia/Manila
RESERVATION_INTERVIEW_TIMEOUT_HOURS=72
RESERVATION_ADMIN_REVIEW_GRACE_HOURS=24

# Tier 1 OCR document verification (text extraction only; no biometrics).
DOCUMENT_OCR_PROVIDER=google_vision
GOOGLE_APPLICATION_CREDENTIALS=storage/app/private/google-credentials/service-account.json
GOOGLE_CLOUD_VISION_SCOPE=https://www.googleapis.com/auth/cloud-platform
DOCUMENT_OCR_MINIMUM_TEXT_LENGTH=25
DOCUMENT_OCR_MINIMUM_MATCH_SCORE=0.72
DOCUMENT_OCR_MINIMUM_NAME_SIMILARITY=0.82
DOCUMENT_OCR_MINIMUM_ADDRESS_SIMILARITY=0.60
DOCUMENT_MAX_ADOPTER_REUPLOADS=1

# Post-adoption welfare media. Legacy photos remain private and read-only.
POST_ADOPTION_TIME_TRAVEL_ENABLED=false
POST_ADOPTION_PHOTO_DISK=local
POST_ADOPTION_MAXIMUM_PHOTO_KILOBYTES=10240
POST_ADOPTION_VIDEO_DISK=local
POST_ADOPTION_MAXIMUM_VIDEO_KILOBYTES=12288
POST_ADOPTION_MAXIMUM_CAPTURE_AGE_SECONDS=300
POST_ADOPTION_CAPTURE_CLOCK_SKEW_SECONDS=120
POST_ADOPTION_VIDEO_DURATION_SECONDS=3
POST_ADOPTION_VIDEO_DURATION_TOLERANCE_SECONDS=0.75
# Set an absolute path to an executable ffprobe binary before accepting video check-ins.
FFPROBE_PATH=
FFPROBE_TIMEOUT_SECONDS=5
C2PATOOL_PATH=
C2PA_SETTINGS_PATH=
C2PA_TRUST_ANCHORS_PATH=
C2PA_TIMEOUT_SECONDS=20
C2PA_MAX_OUTPUT_BYTES=2097152
C2PA_MAX_SIGNING_AGE_MINUTES=15
C2PA_FUTURE_SKEW_SECONDS=120
C2PA_REQUIRE_TRUSTED_TIMESTAMP=true
